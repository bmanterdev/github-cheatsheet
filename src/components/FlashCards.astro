---
/**
 * <FlashCards> — quiz cards. Click / Enter / Space flips; ←/→ navigate; shuffle reorders.
 *
 *   <FlashCards title="Actions quiz" cards={[
 *     { q: 'Default GITHUB_TOKEN lifetime?', a: 'Expires when the job finishes (max 24h).' },
 *   ]} />
 *
 * `q` and `a` accept inline Markdown (**bold**, `code`, [link](url)) or raw HTML.
 */
import { inlineMd, labelsFor, resolveLang, type LabelKey } from './i18n';

interface Props {
	cards: { q: string; a: string }[];
	title?: string;
	lang?: 'en' | 'ja';
	labels?: Partial<Record<LabelKey, string>>;
}

const { cards = [], title, lang, labels } = Astro.props;
const t = labelsFor(resolveLang(lang, Astro.currentLocale), labels);
---

<gh-flash-cards class="gh-widget not-content">
	{title && <p class="gh-widget__title">🃏 {title}</p>}
	<div class="gh-fc__deck">
		{
			cards.map((card, i) => (
				<button
					type="button"
					class="gh-fc__card"
					data-index={i}
					aria-pressed="false"
					hidden={i !== 0}
				>
					<span class="gh-fc__face gh-fc__front">
						<span class="gh-fc__kind">{t.question}</span>
						<span class="gh-fc__text" set:html={inlineMd(card.q)} />
					</span>
					<span class="gh-fc__face gh-fc__back" hidden>
						<span class="gh-fc__kind">{t.answer}</span>
						<span class="gh-fc__text" set:html={inlineMd(card.a)} />
					</span>
				</button>
			))
		}
	</div>
	<p class="gh-fc__hint">{t.flipHint}</p>
	<div class="gh-fc__controls">
		<button type="button" class="gh-btn" data-action="prev" aria-label={t.prev}>← {t.prev}</button>
		<span class="gh-fc__count" aria-live="polite"><span data-pos>1</span> / {cards.length}</span>
		<button type="button" class="gh-btn" data-action="next" aria-label={t.next}>{t.next} →</button>
		<button type="button" class="gh-btn" data-action="shuffle">🔀 {t.shuffle}</button>
	</div>
</gh-flash-cards>

<script>
	class GhFlashCards extends HTMLElement {
		#order: number[] = [];
		#pos = 0;

		connectedCallback() {
			if (this.dataset.ready) return;
			this.dataset.ready = 'true';
			const cards = this.#cards();
			this.#order = cards.map((_, i) => i);
			this.addEventListener('click', (e) => {
				const btn = (e.target as HTMLElement).closest('button');
				if (!btn) return;
				if (btn.classList.contains('gh-fc__card')) this.#flip(btn);
				else if (btn.dataset.action === 'next') this.#go(1);
				else if (btn.dataset.action === 'prev') this.#go(-1);
				else if (btn.dataset.action === 'shuffle') this.#shuffle();
			});
			this.addEventListener('keydown', (e) => {
				if ((e.target as HTMLElement).matches('input, select, textarea')) return;
				if (e.key === 'ArrowRight') this.#go(1);
				else if (e.key === 'ArrowLeft') this.#go(-1);
				else return;
				e.preventDefault();
			});
			this.#render(false);
		}

		#cards() {
			return [...this.querySelectorAll<HTMLButtonElement>('.gh-fc__card')];
		}

		#flip(card: HTMLButtonElement, toBack?: boolean) {
			const back = toBack ?? card.getAttribute('aria-pressed') !== 'true';
			card.setAttribute('aria-pressed', String(back));
			card.querySelector<HTMLElement>('.gh-fc__front')!.hidden = back;
			card.querySelector<HTMLElement>('.gh-fc__back')!.hidden = !back;
		}

		#go(delta: number) {
			const n = this.#order.length;
			if (!n) return;
			this.#pos = (this.#pos + delta + n) % n;
			this.#render(true);
		}

		#shuffle() {
			for (let i = this.#order.length - 1; i > 0; i--) {
				const j = Math.floor(Math.random() * (i + 1));
				[this.#order[i], this.#order[j]] = [this.#order[j], this.#order[i]];
			}
			this.#pos = 0;
			this.#render(true);
		}

		#render(focus: boolean) {
			const cards = this.#cards();
			const current = this.#order[this.#pos];
			cards.forEach((c, i) => {
				c.hidden = i !== current;
				this.#flip(c, false);
			});
			const pos = this.querySelector('[data-pos]');
			if (pos) pos.textContent = String(this.#pos + 1);
			// Keep keyboard focus on the deck if it was on a (now hidden) card.
			const active = document.activeElement;
			if (focus && active && this.contains(active) && active.classList.contains('gh-fc__card')) {
				cards[current]?.focus();
			}
		}
	}

	if (!customElements.get('gh-flash-cards')) customElements.define('gh-flash-cards', GhFlashCards);
</script>

<style>
	gh-flash-cards {
		display: block;
		margin-top: 1.5rem;
	}
	.gh-fc__card {
		display: flex;
		width: 100%;
		min-height: 9rem;
		padding: 1.25rem 1.5rem;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 0.75rem;
		background: var(--sl-color-bg);
		color: var(--sl-color-white);
		font: inherit;
		text-align: start;
		cursor: pointer;
		box-shadow: var(--sl-shadow-sm);
		transition: border-color 0.15s ease;
	}
	.gh-fc__card[hidden] {
		display: none;
	}
	.gh-fc__card:hover {
		border-color: var(--sl-color-accent);
	}
	.gh-fc__card:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	.gh-fc__card[aria-pressed='true'] {
		border-color: var(--gh-success);
		background: color-mix(in srgb, var(--gh-success) 10%, var(--sl-color-bg));
	}
	.gh-fc__face {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}
	.gh-fc__face[hidden] {
		display: none;
	}
	.gh-fc__kind {
		font-size: var(--sl-text-xs);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--sl-color-accent);
	}
	.gh-fc__back .gh-fc__kind {
		color: var(--gh-success);
	}
	.gh-fc__text {
		font-size: var(--sl-text-lg);
	}
	.gh-fc__hint {
		margin: 0.4rem 0 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.gh-fc__controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin-top: 0.75rem;
	}
	.gh-fc__count {
		min-width: 4rem;
		text-align: center;
		font-variant-numeric: tabular-nums;
		color: var(--sl-color-gray-2);
	}
</style>
