---
/**
 * <YamlBuilder> — interactive GitHub Actions workflow builder.
 *
 * `base` is a YAML template containing marker lines such as `# @top`, `# @job`, `# @steps`
 * (any `# @<name>` works). Each option's `snippet` is inserted at the marker named by its
 * `section` (default "steps"). Snippets are de-indented and then re-indented to the marker's
 * indentation, so you can write them flush-left. Marker lines with no enabled snippets are removed.
 * `base` itself is also de-indented. Use spaces (never tabs) for YAML indentation.
 * Inside JS template literals, GitHub expressions must be escaped: `\${{ secrets.TOKEN }}`.
 *
 *   <YamlBuilder
 *     title="CI workflow"
 *     base={`name: CI
 *   on: [push]
 *   # @top
 *   jobs:
 *     build:
 *       runs-on: ubuntu-latest
 *       # @job
 *       steps:
 *         - uses: actions/checkout@v5
 *         # @steps
 *   `}
 *     options={[
 *       { id: 'perms', label: 'Least-privilege token', section: 'top', snippet: `permissions:\n  contents: read`, default: true },
 *       { id: 'node', label: 'Set up Node', snippet: `- uses: actions/setup-node@v4\n  with:\n    node-version: 22` },
 *     ]}
 *   />
 */
import { inlineMd, labelsFor, resolveLang, type LabelKey } from './i18n';

export type YamlOption = {
	id: string;
	label: string;
	snippet: string;
	section?: string;
	description?: string;
	explanation?: string;
	default?: boolean;
};

interface Props {
	base: string;
	options: YamlOption[];
	title?: string;
	filename?: string;
	lang?: 'en' | 'ja';
	labels?: Partial<Record<LabelKey, string>>;
}

const { base, options = [], title, filename, lang, labels } = Astro.props;
const t = labelsFor(resolveLang(lang, Astro.currentLocale), labels);

const MARKER = /^(\s*)#\s*@([\w-]+)\s*$/;

function dedent(text: string) {
	const lines = text.replace(/^\n+|\s+$/g, '').split('\n');
	const indents = lines.filter((l) => l.trim()).map((l) => l.match(/^ */)![0].length);
	const min = indents.length ? Math.min(...indents) : 0;
	return lines.map((l) => l.slice(min));
}

/** Same algorithm as the client script — used for the server-rendered initial state. */
function assemble(enabled: Set<string>) {
	const out: string[] = [];
	for (const line of dedent(base)) {
		const m = line.match(MARKER);
		if (!m) {
			out.push(line);
			continue;
		}
		const [, indent, section] = m;
		for (const opt of options) {
			if (!enabled.has(opt.id) || (opt.section ?? 'steps') !== section) continue;
			for (const l of dedent(opt.snippet)) out.push(l ? indent + l : '');
		}
	}
	return out.join('\n').replace(/\n{3,}/g, '\n\n').trimEnd() + '\n';
}

const initial = assemble(new Set(options.filter((o) => o.default).map((o) => o.id)));
const config = JSON.stringify({
	base,
	options: options.map(({ id, snippet, section }) => ({ id, snippet, section: section ?? 'steps' })),
});
---

<gh-yaml-builder class="gh-widget not-content" data-config={config} data-copy={t.copy} data-copied={t.copied}>
	{title && <p class="gh-widget__title">🛠️ {title}</p>}
	<div class="gh-yb__layout">
		<fieldset class="gh-yb__options">
			<legend>{t.options}</legend>
			{
				options.map((opt) => (
					<div class="gh-yb__option">
						<label>
							<input type="checkbox" value={opt.id} checked={!!opt.default} />
							<span class="gh-yb__label">{opt.label}</span>
						</label>
						{opt.description && (
							<p class="gh-yb__desc" set:html={inlineMd(opt.description)} />
						)}
						{opt.explanation && (
							<p
								class="gh-yb__explain"
								data-explain={opt.id}
								hidden={!opt.default}
								set:html={inlineMd(opt.explanation)}
							/>
						)}
					</div>
				))
			}
		</fieldset>
		<div class="gh-yb__output">
			<div class="gh-yb__bar">
				<span class="gh-yb__filename">{filename ?? 'workflow.yml'}</span>
				<button type="button" class="gh-btn" data-action="copy" aria-live="polite">📋 {t.copy}</button>
			</div>
			<pre tabindex="0"><code>{initial}</code></pre>
		</div>
	</div>
</gh-yaml-builder>

<script>
	type Opt = { id: string; snippet: string; section: string };
	const MARKER = /^(\s*)#\s*@([\w-]+)\s*$/;

	function dedent(text: string) {
		const lines = text.replace(/^\n+|\s+$/g, '').split('\n');
		const indents = lines.filter((l) => l.trim()).map((l) => l.match(/^ */)![0].length);
		const min = indents.length ? Math.min(...indents) : 0;
		return lines.map((l) => l.slice(min));
	}

	function assemble(base: string, options: Opt[], enabled: Set<string>) {
		const out: string[] = [];
		for (const line of dedent(base)) {
			const m = line.match(MARKER);
			if (!m) {
				out.push(line);
				continue;
			}
			const [, indent, section] = m;
			for (const opt of options) {
				if (!enabled.has(opt.id) || opt.section !== section) continue;
				for (const l of dedent(opt.snippet)) out.push(l ? indent + l : '');
			}
		}
		return out.join('\n').replace(/\n{3,}/g, '\n\n').trimEnd() + '\n';
	}

	async function copyText(text: string) {
		try {
			await navigator.clipboard.writeText(text);
			return true;
		} catch {
			const ta = document.createElement('textarea');
			ta.value = text;
			ta.style.position = 'fixed';
			ta.style.opacity = '0';
			document.body.appendChild(ta);
			ta.select();
			const ok = document.execCommand('copy');
			ta.remove();
			return ok;
		}
	}

	class GhYamlBuilder extends HTMLElement {
		connectedCallback() {
			if (this.dataset.ready) return;
			this.dataset.ready = 'true';
			const { base, options } = JSON.parse(this.dataset.config!) as { base: string; options: Opt[] };
			const code = this.querySelector('pre code')!;
			const update = () => {
				const enabled = new Set(
					[...this.querySelectorAll<HTMLInputElement>('input[type=checkbox]')]
						.filter((c) => c.checked)
						.map((c) => c.value),
				);
				code.textContent = assemble(base, options, enabled);
				this.querySelectorAll<HTMLElement>('[data-explain]').forEach((el) => {
					el.hidden = !enabled.has(el.dataset.explain!);
				});
			};
			this.addEventListener('change', update);
			const copyBtn = this.querySelector<HTMLButtonElement>('[data-action=copy]')!;
			copyBtn.addEventListener('click', async () => {
				const ok = await copyText(code.textContent ?? '');
				if (!ok) return;
				copyBtn.textContent = `✅ ${this.dataset.copied}`;
				setTimeout(() => (copyBtn.textContent = `📋 ${this.dataset.copy}`), 1500);
			});
			update();
		}
	}

	if (!customElements.get('gh-yaml-builder')) customElements.define('gh-yaml-builder', GhYamlBuilder);
</script>

<style>
	gh-yaml-builder {
		display: block;
		margin-top: 1.5rem;
		container-type: inline-size;
	}
	.gh-yb__layout {
		display: grid;
		gap: 1rem;
		grid-template-columns: minmax(0, 1fr);
	}
	@container (min-width: 48rem) {
		.gh-yb__layout {
			grid-template-columns: minmax(14rem, 2fr) minmax(0, 3fr);
		}
	}
	.gh-yb__options {
		margin: 0;
		padding: 0;
		border: 0;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}
	.gh-yb__options legend {
		margin-bottom: 0.5rem;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-gray-2);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.gh-yb__option label {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		cursor: pointer;
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.gh-yb__option input {
		width: 1.05rem;
		height: 1.05rem;
		accent-color: var(--sl-color-accent);
	}
	.gh-yb__option input:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	.gh-yb__desc,
	.gh-yb__explain {
		margin: 0.15rem 0 0 1.55rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.gh-yb__explain {
		padding: 0.35rem 0.6rem;
		border-inline-start: 3px solid var(--sl-color-accent);
		background: var(--sl-color-accent-low);
		color: var(--sl-color-accent-high);
		border-radius: 0.25rem;
	}
	.gh-yb__output {
		min-width: 0;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		overflow: hidden;
		background: var(--sl-color-bg);
	}
	.gh-yb__bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem;
		padding: 0.35rem 0.5rem 0.35rem 0.85rem;
		border-bottom: 1px solid var(--sl-color-gray-5);
		background: var(--sl-color-gray-6);
	}
	.gh-yb__filename {
		font-family: var(--__sl-font-mono);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
	}
	.gh-yb__output pre {
		margin: 0;
		padding: 0.85rem 1rem;
		overflow-x: auto;
		max-height: 32rem;
		font-family: var(--__sl-font-mono);
		font-size: var(--sl-text-code-sm, 0.8125rem);
		line-height: 1.6;
		color: var(--sl-color-white);
		background: transparent;
	}
	.gh-yb__output pre:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: -2px;
	}
	.gh-yb__output pre code {
		padding: 0;
		background: none;
		font-size: inherit;
	}
</style>
